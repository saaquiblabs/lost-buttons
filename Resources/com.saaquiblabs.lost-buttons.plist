<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The background item `lost-buttons start` registers (Sources/Service.swift). Lives in
     Contents/Library/LaunchAgents. BundleProgram is relative to the app, so it works wherever the
     app is installed. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.saaquiblabs.lost-buttons</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/lost-buttons</string>
	<key>ProgramArguments</key>
	<array>
		<string>lost-buttons</string>
		<string>run</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.saaquiblabs.lost-buttons</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
